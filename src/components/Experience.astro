---
import { experiences } from '../data/experience';
---

<section class="section" id="experience">
	<div class="container">
		<h2 class="section-title reveal">Experience</h2>
		<p class="section-lead reveal reveal-delay-1">
		</p>
		<ul class="exp-list">
			{
				experiences.map((item, i) => (
					<li class={`exp-item reveal reveal-delay-${(i % 3) + 1}`}>
						<div class="exp-item__period">{item.period}</div>
						<div class="exp-item__body">
							<h3 class="exp-item__role">{item.role}</h3>
							<p class="exp-item__company">{item.company}</p>
							{item.summary && <p class="exp-item__summary">{item.summary}</p>}
							{item.highlights && item.highlights.length > 0 && (
								<ul class="exp-item__highlights">
									{item.highlights.map((line) => (
										<li>{line}</li>
									))}
								</ul>
							)}
						</div>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.exp-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0;
	}

	.exp-item {
		display: grid;
		grid-template-columns: 11rem 1fr;
		gap: 1.25rem;
		padding: 1.45rem 0 1.45rem 0.85rem;
		border-top: 1px solid var(--line);
	}

	.exp-item:last-child {
		border-bottom: 1px solid var(--line);
	}

	.exp-item__period {
		font-size: 0.95rem;
		font-weight: 600;
		color: var(--accent);
		padding-top: 0.2rem;
	}

	.exp-item__role {
		font-size: 1.25rem;
		margin-bottom: 0.2rem;
	}

	.exp-item__company {
		margin: 0;
		font-weight: 600;
		color: var(--ink-muted);
	}

	.exp-item__summary {
		margin: 0.55rem 0 0;
		color: var(--ink-muted);
	}

	.exp-item__highlights {
		margin: 0.7rem 0 0;
		padding-left: 1.15rem;
		color: var(--ink-muted);
	}

	.exp-item__highlights li {
		margin-bottom: 0.3rem;
	}

	code {
		font-size: 0.88em;
		padding: 0.1em 0.35em;
		background: var(--accent-soft);
		border-radius: 3px;
	}

	@media (max-width: 640px) {
		.exp-item {
			grid-template-columns: 1fr;
			gap: 0.35rem;
		}
	}
</style>

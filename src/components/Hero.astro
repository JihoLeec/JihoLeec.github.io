---
import { profile } from '../data/profile';
import { education } from '../data/education';
import { certifications } from '../data/certifications';
---

<section class="hero section" id="about">
	<div class="container hero__grid">
		<div class="hero__photo reveal">
			<div class="photo-slot">
				<img
					class="photo-slot__img"
					src={profile.photoSrc}
					alt={profile.photoAlt}
					width="400"
					height="480"
				/>
				<div class="photo-slot__placeholder" hidden>
					<span>사진</span>
				</div>
			</div>
		</div>

		<div class="hero__right">
			<div class="hero__text reveal reveal-delay-1">
				<h1 class="hero__name">
					<span class="hero__name-en">{profile.name}</span>
				</h1>
			</div>

			<div class="credentials reveal reveal-delay-2" id="credentials">

				<div class="credentials__block">
					<h3 class="credentials__label">Education</h3>
					<ul class="credentials__list">
						{
							education.map((item) => (
								<li class="credentials__item">
									<div class="credentials__row">
										<strong>{item.school + " " + item.degree + " 졸업"}</strong>
										<span class="credentials__period">{item.period}</span>
									</div>
								</li>
							))
						}
					</ul>
				</div>

				<div class="credentials__block credentials__block--certs">
					<h3 class="credentials__label">Certifications</h3>
					<ul class="credentials__list">
						{
							certifications.map((item) => (
								<li class="credentials__item">
									<div class="credentials__row">
										<strong>{item.name}</strong>
										<span class="credentials__period">{item.date}</span>
									</div>
									<p class="credentials__meta">{item.issuer}</p>
								</li>
							))
						}
					</ul>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	const img = document.querySelector('.photo-slot__img') as HTMLImageElement | null;
	const placeholder = document.querySelector('.photo-slot__placeholder') as HTMLElement | null;
	if (img && placeholder) {
		const showPlaceholder = () => {
			img.style.display = 'none';
			placeholder.hidden = false;
		};
		if (img.complete && img.naturalWidth === 0) showPlaceholder();
		img.addEventListener('error', showPlaceholder);
	}
</script>

<style>
	.hero {
		padding-top: clamp(2.5rem, 7vw, 4rem);
		padding-bottom: clamp(2.5rem, 7vw, 4rem);
	}

	.hero__grid {
		display: grid;
		grid-template-columns: minmax(14rem, 20rem) minmax(0, 1fr);
		gap: clamp(1.75rem, 4vw, 3.25rem);
		align-items: start;
	}

	.hero__right {
		display: grid;
		gap: 0.35rem;
		min-width: 0;
	}

	.hero__name {
		display: flex;
		flex-direction: column;
		gap: 0.2em;
		margin: 0;
	}

	.hero__name-en {
		font-size: clamp(1.75rem, 3.5vw, 2.25rem);
		font-weight: 700;
		letter-spacing: -0.015em;
		line-height: 1.12;
		font-stretch: normal;
	}

	.photo-slot {
		position: relative;
		aspect-ratio: 5 / 6;
		width: 100%;
		overflow: hidden;
		border-radius: var(--radius);
		background: linear-gradient(145deg, #2a2a2a, #1c1c1c);
		border: 1px solid var(--line);
		box-shadow: 0 18px 40px rgba(0, 0, 0, 0.28);
		transition:
			box-shadow 0.35s ease,
			transform 0.35s ease;
	}

	.photo-slot:hover {
		transform: translateY(-4px);
		box-shadow:
			0 22px 48px rgba(0, 0, 0, 0.34),
			0 0 0 4px var(--accent-soft),
			0 0 28px var(--glow);
	}

	.photo-slot__img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.photo-slot__placeholder {
		position: absolute;
		inset: 0;
		display: grid;
		place-content: center;
		gap: 0.4rem;
		text-align: center;
		padding: 1.5rem;
		color: var(--ink-muted);
		border: 2px dashed color-mix(in srgb, var(--ink) 22%, transparent);
		margin: 0.75rem;
		border-radius: var(--radius);
	}

	.photo-slot__placeholder span {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 1.15rem;
		color: var(--ink);
	}

	.credentials {
		padding-top: 1rem;
		border-top: 1px solid var(--line);
	}

	.credentials__block + .credentials__block {
		margin-top: 1.15rem;
	}

	.credentials__label {
		font-family: var(--font-display);
		font-size: 1.02rem;
		font-weight: 700;
		letter-spacing: -0.01em;
		text-transform: none;
		color: var(--ink);
		margin-bottom: 0.55rem;
	}

	.credentials__list {
		list-style: none;
		margin: 0;
		padding: 0 0 0 0.85rem;
		display: grid;
		gap: 0.75rem;
	}

	.credentials__block--certs .credentials__list {
		gap: 0.25rem;
	}

	.credentials__item {
		padding: 0.15rem 0;
	}

	.credentials__block--certs .credentials__item {
		padding: 0.05rem 0;
	}

	.credentials__row {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.35rem 1rem;
		align-items: baseline;
	}

	.credentials__row strong {
		font-family: var(--font-body);
		font-size: 0.91rem;
		font-weight: 700;
		color: var(--accent);
	}

	.credentials__period {
		font-size: 0.88rem;
		font-weight: 600;
		color: var(--ink-muted);
		white-space: nowrap;
	}

	.credentials__meta,
	.credentials__detail {
		margin: 0.2rem 0 0;
		font-size: 0.95rem;
		color: var(--ink-muted);
	}

	@media (max-width: 800px) {
		.hero__grid {
			grid-template-columns: 1fr;
		}

		.photo-slot {
			max-width: 18rem;
			margin-inline: auto;
		}
	}
</style>
